{
  "author": "Georg Tavonius <g.tavonius@gmail.com> (http://jaz-lounge.com)",
  "name": "stacktrace-parser",
  "description": "Parses every stack trace into a nicely formatted array of hashes.",
  "main": "dist/stack-trace-parser.cjs.js",
  "module": "dist/stack-trace-parser.esm.js",
  "browser": "dist/stack-trace-parser.umd.js",
  "types": "dist/stack-trace-parser.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "rollup -c rollup.config.mjs -w",
    "dist": "rollup -c rollup.config.mjs && cpy --rename stack-trace-parser.d.ts src/index.d.ts dist/ && cpy --rename stack-trace-parser.test-d.ts src/index.test-d.ts dist/",
    "prepublish": "npm run dist",
    "pretest": "npm run dist",
    "test": "tsd && mocha 'test/**/*.spec.js'",
    "lint": "eslint '{src,test}/**/*.js'",
    "lint:fix": "eslint --fix '{src,test}/**/*.js'"
  },
  "keywords": [
    "errors",
    "stacktrace",
    "parser",
    "exceptions"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "version": "0.1.11",
  "files": [
    "dist/stack-trace-parser.cjs.js",
    "dist/stack-trace-parser.esm.js",
    "dist/stack-trace-parser.umd.js",
    "dist/stack-trace-parser.d.ts",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "type-fest": "^5.9.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expect.js": "^0.3.1",
    "mocha": "^12.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "tsd": "^0.33.0"
  },
  "homepage": "https://github.com/errwischt/stacktrace-parser",
  "repository": {
    "type": "git",
    "url": "https://github.com/errwischt/stacktrace-parser"
  },
  "bugs": {
    "url": "http://github.com/errwischt/stacktrace-parser/issues"
  },
  "license": "MIT"
}
